#!/bin/sh
# Sourced by bin/meerkat_daemon before every command (daemon, pid, stop, ...).
#
# The node name is derived from the socket path, so two engines from two
# installs — or two prefixes, or two sockets — can run side by side. Left at
# the default every release would be `meerkat_daemon@host`, and the second one
# to start would die with "node name seems to be in use" while the first kept
# the socket. Whoever invokes this script with the same MEERKAT_SOCK reaches
# the same node, which is what makes `pid` and `stop` find the right one.
SOCK="${MEERKAT_SOCK:-$HOME/.meerkat/meerkat.sock}"
export MEERKAT_SOCK="$SOCK"
export RELEASE_DISTRIBUTION=sname
export RELEASE_NODE="meerkat_$(printf %s "$SOCK" | cksum | cut -d' ' -f1)"
