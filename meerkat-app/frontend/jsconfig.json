{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["main.js", "js/**/*.js", "types.d.ts"],
  "exclude": ["vendor", "wailsjs", "assets"]
}
