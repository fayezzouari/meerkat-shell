# OS cruft
**/.DS_Store

# Wails build output (regenerated by `wails build`)
meerkat-app/build/

# Wails auto-generated JS/TS bindings (regenerated by `wails build`/`wails dev`)
meerkat-app/frontend/wailsjs/

# Compiled binaries
meerkat-client/meerkat-client

# Release artifacts built by scripts/release.sh — regenerate, don't commit.
meerkat-site/public/downloads/

# Elixir build output and deps
meerkat-daemon/_build/
meerkat-daemon/deps/

# Site dependencies and build output
meerkat-site/node_modules/
meerkat-site/dist/
